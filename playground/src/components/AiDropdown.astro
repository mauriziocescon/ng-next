---
const base = import.meta.env.BASE_URL;
const llmsUrl = 'https://mauriziocescon.github.io/ng-next/llms.txt';
const prompt = encodeURIComponent(`Read from this URL: ${llmsUrl} — explain it to me as an Angular developer working on large-scale enterprise projects with AI-assisted workflows. What problems does it try to solve and how?`);

const links = [
  { label: 'Open in Claude', href: `https://claude.ai/new?q=${prompt}`, icon: '⬡' },
  { label: 'Open in ChatGPT', href: `https://chatgpt.com/?q=${prompt}`, icon: '◈' },
  { label: 'Open in Grok', href: `https://grok.com/?q=${prompt}`, icon: '✦' },
  { label: 'Open in Perplexity', href: `https://www.perplexity.ai/?q=${prompt}`, icon: '◉' },
];
---

<div class="ai-bar">
  <a class="ai-readme-link" href="https://github.com/mauriziocescon/ng-next#readme" target="_blank" rel="noopener noreferrer" aria-label="Read the full README on GitHub">
    <svg class="ai-github-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg><span class="ai-readme-label">README</span>
  </a>
  <div class="ai-dropdown" data-base={base}>
    <button class="ai-trigger" type="button" aria-expanded="false" aria-haspopup="true" aria-controls="ai-menu" aria-label="Open with AI">
      <span aria-hidden="true">🤖</span><span class="ai-trigger-label"> Open with AI</span>
    </button>
  <div id="ai-menu" class="ai-menu" role="menu" hidden>
    {links.map(({ label, href, icon }) => (
      <a href={href} target="_blank" rel="noopener noreferrer" role="menuitem" tabindex="-1" class="ai-menu-item">
        <span class="ai-icon" aria-hidden="true">{icon}</span> {label}
      </a>
    ))}
    <hr class="ai-divider" />
    <button type="button" role="menuitem" tabindex="-1" class="ai-menu-item" data-action="copy">
      <span class="ai-icon" aria-hidden="true">📋</span> Copy spec
    </button>
    <a href={`${base}llms.txt`} download="llms.txt" role="menuitem" tabindex="-1" class="ai-menu-item">
      <span class="ai-icon" aria-hidden="true">⬇</span> Download llms.txt
    </a>
  </div>
  </div>
</div>

<script>
  const dropdown = document.querySelector<HTMLDivElement>('.ai-dropdown')!;
  const base = dropdown.dataset.base!;
  const trigger = dropdown.querySelector<HTMLButtonElement>('.ai-trigger')!;
  const menu = dropdown.querySelector<HTMLDivElement>('.ai-menu')!;
  const copyBtn = menu.querySelector<HTMLButtonElement>('[data-action="copy"]')!;
  const menuItems = [...menu.querySelectorAll<HTMLElement>('[role="menuitem"]')];

  function toggle(open?: boolean) {
    const isOpen = typeof open === 'boolean' ? open : menu.hidden;
    menu.hidden = !isOpen;
    trigger.setAttribute('aria-expanded', String(isOpen));

    if (isOpen && menuItems.length > 0) {
      menuItems[0].setAttribute('tabindex', '0');
      menuItems[0].focus();
    }
  }

  function focusItem(index: number) {
    menuItems.forEach((item) => item.setAttribute('tabindex', '-1'));
    menuItems[index].setAttribute('tabindex', '0');
    menuItems[index].focus();
  }

  trigger.addEventListener('click', () => toggle());

  // Keyboard navigation within the menu
  menu.addEventListener('keydown', (e) => {
    const currentIndex = menuItems.indexOf(document.activeElement as HTMLElement);
    if (currentIndex === -1) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      focusItem((currentIndex + 1) % menuItems.length);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      focusItem((currentIndex - 1 + menuItems.length) % menuItems.length);
    } else if (e.key === 'Home') {
      e.preventDefault();
      focusItem(0);
    } else if (e.key === 'End') {
      e.preventDefault();
      focusItem(menuItems.length - 1);
    } else if (e.key === 'Tab') {
      toggle(false);
    }
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (!dropdown.contains(e.target as Node)) toggle(false);
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) {
      toggle(false);
      trigger.focus();
    }
  });

  // Copy action
  copyBtn.addEventListener('click', async () => {
    try {
      const res = await fetch(`${base}llms.txt`);
      const text = await res.text();
      await navigator.clipboard.writeText(text);
      copyBtn.querySelector('.ai-icon')!.textContent = '✓';
      setTimeout(() => { copyBtn.querySelector('.ai-icon')!.textContent = '📋'; }, 2000);
    } catch (err) {
      console.error('Copy failed:', err);
    }
  });
</script>

<style>
  .ai-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ai-readme-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    font-size: 0.8rem;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.15s;
  }

  .ai-readme-link:hover {
    background: var(--surface-hover);
    color: var(--text);
    border-color: var(--accent);
    text-decoration: none;
  }

  .ai-readme-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .ai-github-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .ai-dropdown {
    position: relative;
    display: inline-block;
  }

  .ai-trigger {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }

  .ai-trigger:hover {
    background: var(--surface-hover);
    color: var(--text);
    border-color: var(--accent);
  }

  .ai-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .ai-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 220px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.4rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    z-index: 100;
  }

  .ai-menu-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.75rem;
    border-radius: 5px;
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
    cursor: pointer;
    border: none;
    background: none;
    width: 100%;
    text-align: left;
    transition: all 0.1s;
  }

  .ai-menu-item:hover {
    background: var(--surface-hover);
    color: var(--text);
  }

  .ai-menu-item:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .ai-icon {
    width: 1.2rem;
    text-align: center;
    flex-shrink: 0;
  }

  .ai-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 0.3rem 0.5rem;
  }

  @media (max-width: 900px) {
    .ai-readme-link {
      min-height: 2.5rem;
      min-width: 2.5rem;
      justify-content: center;
      padding: 0.5rem;
    }

    .ai-readme-link .ai-readme-label {
      display: none;
    }

    .ai-trigger {
      min-height: 2.5rem;
      min-width: 2.5rem;
      justify-content: center;
      padding: 0.5rem;
    }

    .ai-trigger .ai-trigger-label {
      display: none;
    }

    .ai-menu {
      right: 0;
      min-width: 200px;
    }
  }
</style>
