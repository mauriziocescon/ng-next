---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  frontmatter?: {
    title?: string;
    description?: string;
  };
}

const props = Astro.props;
const title = props.title || props.frontmatter?.title || '';
const description = props.description || props.frontmatter?.description || 'Exploring Angular templates for an agentic future — explicit contracts, typed template surfaces, and structures easier for humans, tooling, and AI agents to reason about.';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const sections = [
  { href: `${base}`, label: 'Introduction' },
  { href: `${base}components/`, label: 'Component Basics' },
  { href: `${base}scoping/`, label: 'Lexical Scoping' },
  { href: `${base}directives/`, label: 'Directives' },
  { href: `${base}derivations/`, label: 'Derivations' },
  { href: `${base}refs/`, label: 'Expose & Refs' },
  { href: `${base}fragments-children/`, label: 'Fragments: Children' },
  { href: `${base}fragments-named/`, label: 'Fragments: Named' },
  { href: `${base}proxy/`, label: 'Proxy Forwarding' },
  { href: `${base}wrap/`, label: 'Wrap Forwarding' },
  { href: `${base}di-providers/`, label: 'DI: Providers' },
  { href: `${base}di-tokens/`, label: 'DI: Tokens' },
  { href: `${base}quiz/`, label: 'Quiz' },
];

const currentPath = Astro.url.pathname.replace(/\/?$/, '/');
const currentIndex = sections.findIndex(s => s.href === currentPath);
const prevSection = currentIndex > 0 ? sections[currentIndex - 1] : null;
const nextSection = currentIndex < sections.length - 1 ? sections[currentIndex + 1] : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalUrl.href}>
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}>
  <meta name="theme-color" content="#0f1117">
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl.href}>
  <meta property="og:site_name" content="ng-next">
  <!-- Twitter -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <button class="mobile-menu-toggle" aria-label="Open navigation menu" aria-expanded="false" aria-controls="sidebar-nav" type="button">
    <span aria-hidden="true">☰</span>
  </button>
  <div class="backdrop" aria-hidden="true"></div>
  <div class="app">
    <nav id="sidebar-nav" class="sidebar" aria-label="Sections">
      <p class="sidebar-heading">Exploration</p>
      <ul role="list">
        {sections.map((s, i) => (
          <li>
            <a
              href={s.href}
              class:list={['nav-item', { active: currentPath === s.href }]}
              aria-current={currentPath === s.href ? 'page' : undefined}
            >
              <span class="num" aria-hidden="true">{i + 1}</span>
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <main id="main-content" class="main">
      <slot />
      <nav class="pagination" aria-label="Pagination">
        {prevSection && (
          <a href={prevSection.href} class="pagination-link prev" aria-label={`Previous: ${prevSection.label}`}>
            <span class="pagination-arrow" aria-hidden="true">←</span>
            <span class="pagination-label">{prevSection.label}</span>
          </a>
        )}
        {nextSection && (
          <a href={nextSection.href} class="pagination-link next" aria-label={`Next: ${nextSection.label}`}>
            <span class="pagination-label">{nextSection.label}</span>
            <span class="pagination-arrow" aria-hidden="true">→</span>
          </a>
        )}
      </nav>
    </main>
  </div>
  <script define:vars={{ prevHref: prevSection?.href, nextHref: nextSection?.href }}>
    document.addEventListener('keydown', (e) => {
      const target = e.target;
      if (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.tagName === 'BUTTON') return;
      if (e.key === 'ArrowLeft' && prevHref) {
        window.location.href = prevHref;
      } else if (e.key === 'ArrowRight' && nextHref) {
        window.location.href = nextHref;
      }
    });

    // Mobile menu toggle
    const toggle = document.querySelector('.mobile-menu-toggle');
    const sidebar = document.getElementById('sidebar-nav');
    const backdrop = document.querySelector('.backdrop');
    if (toggle && sidebar && backdrop) {
      function openMenu() {
        sidebar.classList.add('open');
        backdrop.classList.add('visible');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', 'Close navigation menu');
      }
      function closeMenu() {
        sidebar.classList.remove('open');
        backdrop.classList.remove('visible');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open navigation menu');
      }
      toggle.addEventListener('click', () => {
        sidebar.classList.contains('open') ? closeMenu() : openMenu();
      });
      backdrop.addEventListener('click', closeMenu);
      // Close on link click (mobile)
      sidebar.addEventListener('click', (e) => {
        if (e.target.closest('a')) closeMenu();
      });
      // Close on Escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && sidebar.classList.contains('open')) {
          closeMenu();
          toggle.focus();
        }
      });
    }
  </script>
</body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 1000;
    padding: 0.5rem 1rem;
    background: var(--accent);
    color: white;
    border-radius: 4px;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .skip-link:focus {
    top: 1rem;
  }

  .app {
    display: flex;
    min-height: 100vh;
  }

  .sidebar {
    width: var(--nav-width);
    background: var(--surface);
    border-right: 1px solid var(--border);
    padding: 2rem 0;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    overflow-y: auto;
  }

  .sidebar-heading {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    padding: 0 1.5rem;
    margin-bottom: 1.5rem;
  }

  .sidebar ul {
    list-style: none;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1.5rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    border-left: 3px solid transparent;
    transition: all 0.15s;
    text-decoration: none;
  }

  .nav-item:hover {
    background: var(--surface-hover);
    color: var(--text);
    text-decoration: none;
  }

  .nav-item:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .nav-item.active {
    background: var(--accent-glow);
    color: var(--accent);
    border-left-color: var(--accent);
  }

  .num {
    font-size: 0.75rem;
    font-weight: 600;
    width: 1.5rem;
    height: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--border);
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .nav-item.active .num {
    background: var(--accent);
    color: white;
  }

  .main {
    flex: 1;
    margin-left: var(--nav-width);
    padding: 3rem 4rem;
    max-width: 900px;
  }

  .mobile-menu-toggle {
    display: none;
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 1001;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: 1.2rem;
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }

  .mobile-menu-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 999;
  }

  @media (max-width: 900px) {
    .mobile-menu-toggle { display: flex; }
    .sidebar { display: none; }
    .sidebar.open {
      display: block;
      z-index: 1000;
      width: 100%;
      max-width: 300px;
      padding-top: 4rem;
    }
    .backdrop.visible { display: block; }
    .main { margin-left: 0; padding: 3.5rem 1.25rem 2rem; }
    .pagination { flex-direction: column; gap: 0.75rem; }
    .pagination-link.next { margin-left: 0; align-self: flex-end; }
  }

  .pagination {
    display: flex;
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .pagination-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-radius: 6px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: all 0.15s;
  }

  .pagination-link:hover {
    background: var(--surface-hover);
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }

  .pagination-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .pagination-link.next {
    margin-left: auto;
  }

  .pagination-arrow {
    font-size: 1.1rem;
  }
</style>

<style is:global>
  /* Content typography */
  .main h2 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, var(--accent), #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .main .subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.5rem;
  }

  .main p, .main li {
    color: var(--text-muted);
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .main ul {
    list-style: none;
    padding-left: 0;
  }

  .main ul li::before {
    content: "→ ";
    color: var(--accent);
  }

  .main h3 {
    font-size: 1.2rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--text);
  }

  /* Code blocks — Shiki themed */
  .main pre {
    margin: 1.5rem 0;
    border-radius: 8px;
    border: 1px solid var(--border);
    padding: 1.25rem;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .main pre code {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
  }

  .main code:not(pre code) {
    background: var(--surface);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
  }

  /* Annotations */
  .annotation {
    background: var(--accent-glow);
    border-left: 3px solid var(--accent);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    border-radius: 0 8px 8px 0;
    font-size: 0.9rem;
  }

  .annotation strong {
    color: var(--accent);
  }

  /* Mobile content adjustments */
  @media (max-width: 900px) {
    .main h2 {
      font-size: 1.5rem;
    }

    .main .subtitle {
      font-size: 1rem;
    }

    .main pre {
      margin: 1rem -1.25rem;
      border-radius: 0;
      border-left: none;
      border-right: none;
      padding: 1rem;
      font-size: 0.78rem;
    }

    .annotation {
      margin: 1rem -0.5rem;
      padding: 0.75rem 1rem;
      font-size: 0.85rem;
    }
  }
</style>
